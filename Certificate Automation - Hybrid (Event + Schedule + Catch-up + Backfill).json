    {
      "parameters": {
        "jsCode": "const now = Date.now();\nreturn $input.all().map(i => i.json)\n  .filter(r => r.cert_id && ['pending', 'failed'].includes(r.status) &&\n               (now - new Date(r.created_at).getTime()) / 60000 > 15)\n  .slice(0, 20)\n  .map(r => ({ json: { cert_id: r.cert_id, name: r.name, email: r.email, course: r.course, score: r.score, mode: 'issue' } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        1040
      ],
      "id": "9a9b2f3c-d9b6-4096-bd34-6920a85a0450",
      "name": "Find Pending"
    },
