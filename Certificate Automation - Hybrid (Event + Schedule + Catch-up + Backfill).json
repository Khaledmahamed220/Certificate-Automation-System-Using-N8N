        "jsCode": "const since = Date.now() - 7 * 864e5;\nconst rows = $input.all().map(i => i.json)\n  .filter(r => r.status === 'issued' && r.issued_at && new Date(r.issued_at).getTime() > since)\n  .map(r => ({ json: { cert_id: r.cert_id, name: r.name, email: r.email, course: r.course, score: r.score, issued_at: r.issued_at } }));\nif (!rows.length) return [{ json: { note: 'No certificates issued this week' } }];\nreturn rows;"
      },
